  <div class="container mt-5">
    <h2>Lista de Doctores</h2>
    <div class="d-flex justify-content-between align-items-center mb-1" style="min-height: 100px;">
      <% if (user.role === 'admin') { %>
      <a class="btn btn-primary" href="/<%= moduleName %>/form/new">Agregar Doctor</a>
      <% } %>
      <form class="form-inline" method="GET" action="<%= moduleName %>">
        <input class="form-control mr-sm-2" type="search" placeholder="Buscar doctor" aria-label="Buscar" name="search" value="<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>">
        <button class="btn btn-outline-success my-2 my-sm-0" type="submit">Buscar</button>
      </form>
      <%- include('../../../../views/partials/pages',{ modelView: 'itemes' }) %>
    </div>

    <div style="margin: 20px 0;">
      <a href="/Hospital/doctores/new" class="btn btn-primary">Agregar Doctor</a>
    </div>

    <table class="table table-striped">
      <thead>
        <tr>
          <th>#</th>
          <th>Nombre</th>
          <th>Cédula</th>
          <th>Especialidad</th>
          <th>Turno</th>
          <th>Acciones</th>
        </tr>
      </thead>
      <tbody>
        <% results.forEach((item, index) => { %>
          <tr>
            <td><%= index + 1 %></td>
            <td><%= item.nombre %></td>
            <td><%= item.cedula %></td>
            <td><%= item.especialidad %></td>
            <td><%= item.turno %></td>
            <td>
              <a href="/<%= moduleName %>/form/edit/<%= item._id %>" class="btn btn-sm btn-warning">Editar</a>
              <form action="/<%= moduleName %>/form/delete/<%= item._id %>" method="POST" class="d-inline">
                <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('¿Está seguro de eliminar este doctor?');">Eliminar</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>